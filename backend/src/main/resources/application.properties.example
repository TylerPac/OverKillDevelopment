# Example application.properties (do NOT commit secrets)
# Copy values into your environment / .env file instead.

# Server port used by the Spring Boot app (used in container runtime via SERVER_PORT)
server.port=8080

# Spring profile and JDBC connection for local/dev example
spring.profiles.active=dev-mysql
spring.datasource.url=jdbc:mysql://localhost:3306/tylerpac_dev
spring.datasource.username=root
spring.datasource.password=password

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# Security
spring.main.allow-bean-definition-overriding=true

# Flyway disabled by default; enable if you add migrations
spring.flyway.enabled=false

# Stripe / Shop
app.shop.currency=usd
app.shop.success-url=http://localhost:5173
app.shop.cancel-url=http://localhost:5173
app.shop.admin-token=${SHOP_ADMIN_TOKEN}
app.shop.download-root=downloads
app.stripe.secret-key=${STRIPE_SECRET_KEY}
app.stripe.webhook-secret=${STRIPE_WEBHOOK_SECRET}
app.stripe.premium-price-id=${STRIPE_PREMIUM_PRICE_ID}
